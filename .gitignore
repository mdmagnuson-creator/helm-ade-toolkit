node_modules
# Allow plugin dependencies (no npm install step in toolkit pipeline)
!plugins/*/node_modules/

.vscode
.DS_Store
*.log
.env
.env.local
.tmp/
.opencode/

# Instance-specific mutable state (NOT part of toolkit)
projects.json
builder-config.json
bun.lock
package.json
# Allow plugin package files (plugins are self-contained)
!plugins/*/package.json
!plugins/*/package-lock.json

# Agent communication queues (instance-specific)
project-updates/
pending-updates/
!skills/pending-updates/

# Local user overrides (machine-specific)
.local/toolkit-overrides.json
